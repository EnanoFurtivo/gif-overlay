#!/usr/bin/env python3
"""gif-overlay launcher: runs the gif_overlay package (next to this file, or installed)."""
import os, sys

here = os.path.dirname(os.path.realpath(__file__))
for base in (here, os.path.join(os.environ.get("XDG_DATA_HOME") or
                                os.path.expanduser("~/.local/share"), "gif-overlay")):
    if os.path.isdir(os.path.join(base, "gif_overlay")):
        sys.path.insert(0, base)
        break

import gif_overlay.app  # noqa: E402,F401  (the app runs on import)
